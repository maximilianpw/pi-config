{
  "name": "maxpw-pi-config",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "bun run typecheck && bun run test && bun run --filter pi-save-md-extension check && bun run --filter pi-web-tools-extension check"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

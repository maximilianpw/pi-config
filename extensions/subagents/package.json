{
  "name": "pi-subagents-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types manager.test.ts result-delivery.test.ts context-usage.test.ts takeover.test.ts by-the-way.test.ts",
    "test:live": "node --test --experimental-strip-types claude.test.ts codex.test.ts",
    "check": "bun run typecheck && bun run test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "effect": "^4.0.0-beta.99"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "typescript": "^7.0.2"
  }
}
